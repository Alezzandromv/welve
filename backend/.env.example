# Conexión a Supabase Postgres vía el connection pooler (Supavisor), modo transacción.
# Necesaria en entornos sin salida IPv6 (p.ej. GitHub Codespaces) — la conexión directa
# (db.<project_ref>.supabase.co:5432) solo resuelve IPv6 en la mayoría de proyectos.
# Obtener el host exacto en: Supabase Dashboard → Project Settings → Database → Connection Pooling.
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres

SECRET_KEY=                   # openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://localhost:6379
WHATSAPP_TOKEN=               # Meta Cloud API bearer token
WHATSAPP_PHONE_ID=            # ID del número de WhatsApp Business
WHATSAPP_VERIFY_TOKEN=        # Token secreto para verificación del webhook de Meta
APP_URL=http://localhost:5173  # URL pública del frontend (en Codespaces: https://*.app.github.dev)
ENVIRONMENT=development
